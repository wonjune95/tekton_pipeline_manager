<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN" "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="Board">
  <select id="boardDAO.selectBoardList" parameterClass="boardVO" resultClass="egovMap">
    <!-- ruleid: mois-1-01-sql-injection-mybatis -->
    SELECT ntt_id, ntt_sj FROM tb_board WHERE ntt_sj LIKE '%$searchKeyword$%'
  </select>
  <!-- 동적 태그 안, 객체 속성($a.b$), 반복($ids[]$) -->
  <select id="boardDAO.selectBoardListByCondition" parameterClass="boardVO" resultClass="egovMap">
    SELECT ntt_id, ntt_sj FROM tb_board
    <dynamic prepend="WHERE">
      <!-- ruleid: mois-1-01-sql-injection-mybatis -->
      <isNotEmpty property="searchKeyword">ntt_sj = '$searchKeyword$'</isNotEmpty>
      <!-- ruleid: mois-1-01-sql-injection-mybatis -->
      <iterate prepend="AND ntt_id IN" property="nttIds" open="(" close=")" conjunction=",">$nttIds[]$</iterate>
    </dynamic>
    <!-- ruleid: mois-1-01-sql-injection-mybatis -->
    ORDER BY $search.sortColumn$
  </select>
</sqlMap>
